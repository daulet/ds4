    "adoption_constraints": [
      "cuda-oxide describes itself as experimental alpha software, so DS4 retains current-C CUDA oracles until stage-specific parity is proven.",
      "cuda-oxide provides substrate capabilities rather than DS4-specific kernels; each operation and resource lifetime below still requires implementation and comparison.",
      "CUDA code generation and execution validation must run on the recorded B300 CUDA environment with the required cuda-oxide Rust, LLVM, Clang, and CUDA toolchain available."
    ]
  },
  "stages": [
    {
      "stage": "M14.1",
      "title": "cuda-oxide Substrate And Tensor Residency",
      "goal": "Introduce the feature-gated cuda-oxide Rust CUDA context, streams, device/residency buffers, command synchronization, model-map caching ownership, and memory-report contract.",
      "oracle": "Current ds4_cuda.cu resource lifetime, tensor transfer, and model caching paths.",
      "comparator": "Tensor allocation/copy/read-write fixtures plus B300 model-map and memory-report smoke.",
      "acceptance": "Rust owns this resource/lifetime surface on an opt-in route and current-C remains default until downstream operation stages close."
    },
    {
      "stage": "M14.2",
      "title": "Embedding Indexer And Elementwise Kernels",
      "goal": "Move embedding, indexer/top-k, repeat, swiglu, add, and directional-steering kernels into Rust cuda-oxide modules.",
      "oracle": "M13 fixture and route artifacts plus current-C tensor dumps.",
      "comparator": "M13 operation fixtures extended to execute Rust-owned kernel output on B300.",
      "acceptance": "Every assigned operation runs through Rust CUDA kernels with documented numeric tolerances and no default-route promotion."
    },
    {
      "stage": "M14.3",
      "title": "Dense Projection Quantization And Norm Kernels",
      "goal": "Move dense matmul, q8 paths, fused projection helpers, and normalization kernels plus required BLAS calls into Rust.",
      "oracle": "Current-C intermediate tensor and graph checkpoint fixtures.",
      "comparator": "Operation-level tensor comparators followed by official-vector and short-decode replay.",
      "acceptance": "All assigned operations are Rust-owned and preserve current output/tolerance and quality-mode BLAS decisions."
    },
    {
      "stage": "M14.4",
      "title": "RoPE KV Compressor And Attention Kernels",
      "goal": "Move RoPE, FP8/raw KV storage, compressed-cache updates, and raw/mixed/indexed attention kernels into Rust.",
      "oracle": "Current-C prefill, decode, long-indexed-attention, and KV/session artifacts.",
      "comparator": "B300 tensor and long-context continuation comparisons including cache restore behavior.",
      "acceptance": "Rust-owned attention/cache execution passes long-context and KV parity while the C backend remains an oracle."
    },
    {
      "stage": "M14.5",
      "title": "Router MoE And Hyperconnection Kernels",
      "goal": "Move router selection, routed MoE, and hyperconnection reduction/expansion kernels into Rust.",
      "oracle": "Current-C graph checkpoints, tool/server quality, and benchmark artifacts.",
      "comparator": "B300 full-graph output, quality, and same-session throughput comparisons.",
      "acceptance": "The final CUDA operation family is Rust-owned without behavior or measured performance overclaim."
    },
    {
      "stage": "M14.6",
      "title": "CUDA Route Promotion And C CUDA Removal Gate",
      "goal": "Promote the Rust CUDA backend only after all M14 operation and resource ownership stages close, then remove ds4_cuda.cu linkage if the removal criteria pass.",
      "oracle": "All M14 artifacts plus official-vector, long-context, tool/server, and benchmark closure gates.",
      "comparator": "End-to-end Rust CUDA route versus retained current-C CUDA baseline on the same B300 session.",
      "acceptance": "Default-route promotion and ds4_cuda.cu removal are rejected unless all assigned exported functions and kernels are Rust-owned and end-to-end gates pass."
    }
  ],
